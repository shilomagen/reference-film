{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reference-film.local/schemas/project-config.schema.json",
  "title": "Reference Film project configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["metadata", "visualStyle", "characters", "inputs", "outputs", "providers", "models"],
  "properties": {
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "required": ["slug", "title"],
      "properties": {
        "slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
        "title": { "type": "string", "minLength": 1, "maxLength": 120 },
        "description": { "type": "string", "maxLength": 500 }
      }
    },
    "visualStyle": { "type": "string", "minLength": 1, "maxLength": 2000 },
    "characters": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["description"],
        "properties": {
          "description": { "type": "string", "minLength": 1, "maxLength": 1000 }
        }
      }
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "required": ["plan", "faces"],
      "properties": {
        "plan": { "type": "string", "minLength": 1 },
        "brief": { "type": "string", "minLength": 1 },
        "lyrics": { "type": "string", "minLength": 1 },
        "timings": { "type": "string", "minLength": 1 },
        "faces": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "anyOf": [
              { "type": "string", "minLength": 1 },
              { "type": "array", "items": { "type": "string", "minLength": 1 } }
            ]
          }
        },
        "audioCandidates": { "type": "array", "items": { "type": "string", "minLength": 1 } }
      }
    },
    "outputs": { "type": "string", "minLength": 1 },
    "envFile": { "type": "string", "minLength": 1 },
    "providers": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "image", "judge", "video"],
      "properties": {
        "text": { "const": "xai" },
        "image": { "const": "xai" },
        "judge": { "const": "xai" },
        "video": { "enum": ["xai", "gemini"] }
      }
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "image", "judge", "video", "geminiVideo"],
      "properties": {
        "text": { "type": "string", "minLength": 1 },
        "image": { "type": "string", "minLength": 1 },
        "judge": { "type": "string", "minLength": 1 },
        "video": { "type": "string", "minLength": 1 },
        "geminiVideo": { "type": "string", "minLength": 1 }
      }
    },
    "generation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "imageCandidates": { "type": "integer", "minimum": 1, "maximum": 12 },
        "imageRounds": { "type": "integer", "minimum": 1, "maximum": 10 },
        "videoAttempts": { "type": "integer", "minimum": 1, "maximum": 10 },
        "concurrency": { "type": "integer", "minimum": 1, "maximum": 32 },
        "pollIntervalMs": { "type": "integer", "minimum": 100 },
        "pollTimeoutMs": { "type": "integer", "minimum": 1000 },
        "retry": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "attempts": { "type": "integer", "minimum": 0, "maximum": 20 },
            "baseDelayMs": { "type": "integer", "minimum": 0 },
            "maxDelayMs": { "type": "integer", "minimum": 0 },
            "jitter": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "quality": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "judgeEnabled": { "type": "boolean" },
        "imageIdentityMinimum": { "type": "number", "minimum": 0, "maximum": 100 },
        "imageAnatomyMinimum": { "type": "number", "minimum": 0, "maximum": 100 },
        "imageCharactersMinimum": { "type": "number", "minimum": 0, "maximum": 100 },
        "videoIdentityMinimum": { "type": "number", "minimum": 0, "maximum": 100 },
        "videoStabilityMinimum": { "type": "number", "minimum": 0, "maximum": 100 },
        "rubric": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "identity": { "type": "number", "minimum": 0, "maximum": 1 },
            "correct_characters": { "type": "number", "minimum": 0, "maximum": 1 },
            "scene_readability": { "type": "number", "minimum": 0, "maximum": 1 },
            "anatomy": { "type": "number", "minimum": 0, "maximum": 1 },
            "cinematic_style": { "type": "number", "minimum": 0, "maximum": 1 },
            "creative_intent": { "type": "number", "minimum": 0, "maximum": 1 }
          }
        }
      }
    },
    "assembly": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "width": { "type": "integer", "minimum": 16 },
        "height": { "type": "integer", "minimum": 16 },
        "fps": { "type": "number", "exclusiveMinimum": 0 },
        "codec": { "type": "string", "minLength": 1 },
        "crf": { "type": "integer", "minimum": 0, "maximum": 63 },
        "audioBitrate": { "type": "string", "minLength": 1 },
        "freezeFrameSeconds": { "type": "number", "minimum": 0 }
      }
    }
  }
}
