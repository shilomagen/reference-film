{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reference-film.local/schemas/lyrics.schema.json",
  "title": "Structured lyrics",
  "type": "object",
  "additionalProperties": false,
  "required": ["title", "language", "music_direction", "sections"],
  "properties": {
    "title": { "type": "string", "minLength": 1, "maxLength": 160 },
    "language": { "type": "string", "minLength": 2, "maxLength": 80 },
    "music_direction": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "sections": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["section_id", "label", "repeat", "lines"],
        "properties": {
          "section_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "maxLength": 64 },
          "label": { "type": "string", "minLength": 1, "maxLength": 120 },
          "repeat": { "type": "boolean" },
          "lines": {
            "type": "array",
            "minItems": 1,
            "maxItems": 16,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["line_id", "text"],
              "properties": {
                "line_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "maxLength": 80 },
                "text": { "type": "string", "minLength": 1, "maxLength": 300 }
              }
            }
          }
        }
      }
    }
  }
}
