{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reference-film.local/schemas/scene-plan.schema.json",
  "title": "Reference Film scene plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["video"],
  "properties": {
    "video": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "scenes"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "description": { "type": "string" },
        "scenes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 120,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["scene_id", "section", "lyrics", "lyric_ids", "duration_seconds", "characters", "image_generation", "video_generation"],
            "properties": {
              "scene_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "maxLength": 64 },
              "section": { "type": "string", "minLength": 1 },
              "lyrics": { "type": "string", "maxLength": 1200 },
              "lyric_ids": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" } },
              "duration_seconds": { "type": "number", "exclusiveMinimum": 0, "maximum": 60 },
              "lock_duration": { "type": "boolean" },
              "characters": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$" } },
              "source_image": { "type": "string", "minLength": 1 },
              "source_image_mode": { "const": "direct_animation" },
              "image_generation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["prompt", "negative_prompt", "aspect_ratio"],
                "properties": {
                  "prompt": { "type": "string", "minLength": 1 },
                  "negative_prompt": { "type": "string", "minLength": 1 },
                  "aspect_ratio": { "type": "string", "pattern": "^[1-9][0-9]*:[1-9][0-9]*$" }
                }
              },
              "video_generation": {
                "type": "object",
                "additionalProperties": false,
                "required": ["scene_description", "prompt", "camera", "motion", "ending_frame"],
                "properties": {
                  "scene_description": { "type": "string", "minLength": 1 },
                  "prompt": { "type": "string", "minLength": 1 },
                  "camera": { "type": "string", "minLength": 1 },
                  "motion": { "type": "string", "minLength": 1 },
                  "ending_frame": { "type": "string", "minLength": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
