{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://reference-film.local/schemas/creator-brief.schema.json",
  "title": "Creator brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["project_slug", "subject", "occasion", "relationship", "intended_message", "facts", "supporting_characters", "language", "music", "boundaries", "consent"],
  "properties": {
    "project_slug": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$", "maxLength": 64 },
    "subject": {
      "type": "object",
      "additionalProperties": false,
      "required": ["character_id", "display_name", "reference_files"],
      "properties": {
        "character_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "maxLength": 64 },
        "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
        "pronouns": { "type": "string", "minLength": 1, "maxLength": 80 },
        "reference_files": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
      }
    },
    "occasion": { "type": "string", "minLength": 1, "maxLength": 300 },
    "relationship": { "type": "string", "minLength": 1, "maxLength": 300 },
    "intended_message": { "type": "string", "minLength": 1, "maxLength": 1000 },
    "facts": {
      "type": "object",
      "additionalProperties": false,
      "required": ["memories", "details", "personality", "interests"],
      "properties": {
        "memories": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "details": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
        "personality": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } },
        "interests": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 300 } }
      }
    },
    "supporting_characters": {
      "type": "array",
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["character_id", "display_name", "relationship", "reference_files"],
        "properties": {
          "character_id": { "type": "string", "pattern": "^[a-z0-9]+(?:_[a-z0-9]+)*$", "maxLength": 64 },
          "display_name": { "type": "string", "minLength": 1, "maxLength": 120 },
          "pronouns": { "type": "string", "minLength": 1, "maxLength": 80 },
          "relationship": { "type": "string", "minLength": 1, "maxLength": 300 },
          "reference_files": { "type": "array", "maxItems": 12, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 500 } }
        }
      }
    },
    "language": { "type": "string", "minLength": 2, "maxLength": 80 },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "required": ["characteristics", "tone", "target_duration_seconds"],
      "properties": {
        "characteristics": { "type": "array", "minItems": 1, "maxItems": 12, "items": { "type": "string", "minLength": 1, "maxLength": 200 } },
        "tone": { "type": "string", "minLength": 1, "maxLength": 300 },
        "target_duration_seconds": { "type": "integer", "minimum": 20, "maximum": 900 }
      }
    },
    "boundaries": { "type": "array", "maxItems": 20, "items": { "type": "string", "minLength": 1, "maxLength": 500 } },
    "consent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["personal_details_provider_disclosure"],
      "properties": {
        "personal_details_provider_disclosure": { "const": true },
        "statement": { "type": "string", "minLength": 1, "maxLength": 500 }
      }
    }
  }
}
