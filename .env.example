# Environment files are loaded only with --env <path>. Never commit credentials.
XAI_API_KEY=
# GROK_API_KEY is accepted as a compatibility alias for XAI_API_KEY.
XAI_API_BASE_URL=https://api.x.ai/v1
GROK_API_BASE_URL=

GEMINI_API_KEY=
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Optional project-scoped model overrides
XAI_TEXT_MODEL=
XAI_IMAGE_MODEL=
XAI_JUDGE_MODEL=
XAI_VIDEO_MODEL=
GEMINI_VIDEO_MODEL=
